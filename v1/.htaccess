# GarageMinder Mobile API v1
# URL Rewriting - Routes all requests to index.php
# Clean URLs: /gm/api/v1/vehicles (no index.php)

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /gm/api/v1/

    # Block access to sensitive directories
    RewriteRule ^config/ - [F,L]
    RewriteRule ^core/ - [F,L]
    RewriteRule ^middleware/ - [F,L]
    RewriteRule ^endpoints/ - [F,L]
    RewriteRule ^models/ - [F,L]

    # Allow admin-tester static files through
    RewriteRule ^admin-tester/(.+\.(html|css|js|png|ico))$ admin-tester/$1 [L]

    # If the request is for an actual file or directory, serve it directly
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    # Route everything else to index.php
    # The [QSA,L] passes query strings and stops further rules
    RewriteRule ^(.*)$ index.php/$1 [QSA,L]
</IfModule>

# Fallback for hosts where mod_rewrite might not work
# This tells Apache to use index.php as the handler for missing resources
<IfModule !mod_rewrite.c>
    FallbackResource /gm/api/v1/index.php
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Prevent directory listing
Options -Indexes

# Force HTTPS
<IfModule mod_rewrite.c>
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Block access to hidden files
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# Block access to .key files
<FilesMatch "\.key$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
